{
  "name": "magiarium-api",
  "author": "9dryavka",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "node:prettier": "prettier --check .",
    "node:prettier:fix": "prettier --write .",
    "node:lint": "eslint .",
    "node:lint:fix": "eslint . --fix",
    "node:check": "npm run node:prettier && npm run node:lint",
    "node:fix": "npm run node:prettier:fix && npm run node:lint:fix",
    "node:build": "npm run node:check && tsc",
    "sam:validate": "sam validate",
    "sam:build": "npm run sam:validate && sam build",
    "check": "npm run node:check && npm run sam:validate",
    "deploy:dev": "npm run node:build && npm run sam:build && sam deploy --config-env dev",
    "deploy:prod": "npm run node:build && npm run sam:build && sam deploy --config-env prod"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1133.0",
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/client-ses": "^3.1134.0",
    "@aws-sdk/lib-dynamodb": "^3.1133.0",
    "@magiarium/structure": "github:magiarium/magiarium-structure",
    "dayjs": "^1.11.23",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^22.20.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.1.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
